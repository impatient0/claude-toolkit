#!/bin/sh
# Refuses a merge made in the main checkout.
#
# A clean `git merge` never runs pre-commit, so without this the main checkout's
# one remaining path to a commit stays open. See CLAUDE.md#version-control.
#
# Enabled per clone: git config core.hooksPath scripts/git-hooks

git_dir=$(git rev-parse --git-dir) || exit 0
common_dir=$(git rev-parse --git-common-dir) || exit 0
git_dir=$(cd "$git_dir" 2>/dev/null && pwd -P) || exit 0
common_dir=$(cd "$common_dir" 2>/dev/null && pwd -P) || exit 0

if [ "$git_dir" = "$common_dir" ]; then
  echo "pre-merge-commit: refusing a merge in the main checkout." >&2
  echo "  Merge from inside your own worktree; see the merge-to-main skill." >&2
  exit 1
fi

exit 0
