{
  "name": "claude-toolkit",
  "version": "0.1.0",
  "description": "Portable Claude Code skills, mechanical PreToolUse/git guards, doc linters, and headless browser REPL.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "claude-toolkit": "./bin/claude-toolkit.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs && npm run check:doc-links && npm run check:doc-format",
    "check:hooks": "node --test tests/guard-*.test.mjs tests/gitHooks.test.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:doc-format": "node scripts/reflow-docs.mjs --check",
    "format:docs": "node scripts/reflow-docs.mjs",
    "check:browser-driver": "node --test .claude/skills/browser-driver/click-target.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.52.0"
  }
}
